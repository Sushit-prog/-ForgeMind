# Copy to `.env` and adjust. NEVER commit a real .env file.

# Application
APP_NAME=forgemind
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — local dev (matches docker-compose.yml; host port 5433 to avoid
# clashing with a system Postgres on 5432); prod points at Supabase:
# postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://forgemind:forgemind@localhost:5433/forgemind

# Task queue (arq) — matches the redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
# Set to false to stop the API from enqueuing (hermetic tests do this).
QUEUE_ENABLED=true
# Re-enqueue non-terminal tasks on worker startup (crash recovery).
WORKER_SWEEP_ENABLED=true

# Where cached clones and per-task worktrees live (Phase 4).
# REPO_CACHE_DIR=.forgemind/repos

# LLM provider (Phase 5) — every agent runs real LLM calls through the
# provider built for ITS role. Per-role model selection (swapping models is
# config, not code):
# OPENROUTER_API_KEY=
# LLM_MODEL_PLANNER=anthropic/claude-3.5-sonnet
# LLM_MODEL_RESEARCH=anthropic/claude-3.5-sonnet
# LLM_MODEL_DEVELOPER=anthropic/claude-3.5-sonnet
# LLM_MODEL_DEBUGGER=anthropic/claude-3.5-sonnet
# LLM_MODEL_REVIEWER=anthropic/claude-3.5-sonnet
# LLM_MODEL_SECURITY=anthropic/claude-3.5-sonnet
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
#
# Optional per-role FALLBACK chains (LLM_MODEL_<ROLE>_FALLBACKS): a comma-
# separated, ordered list of model slugs tried when the primary model keeps
# returning TRANSIENT errors — free-tier per-model 429 rate limits above all.
# Each model gets its own LLM_MAX_RETRIES budget before the request hops to
# the next; non-transient errors (400/401, malformed output) never trigger a
# hop. Empty/unset = plain single-model behavior.
# Suggested free-tier chain (slugs verified against OpenRouter's catalog in
# Aug 2026 — free models rotate often, re-check openrouter.ai/models).
# Planner + Developer run a FOUR-tier chain: free NVIDIA NIM models first
# (nvidia:: prefix -> integrate.api.nvidia.com, free-tier NIM quota), the
# existing free OpenRouter chain second, PAID Inception Mercury last as the
# final fallback (only reached when everything above is exhausted):
#   nvidia ultra -> nvidia lightning -> free OpenRouter chain -> mercury
# (NIM/Inception don't use OpenRouter's ":free" suffix — drop it when the
#  slug crosses onto those endpoints):
# LLM_MODEL_PLANNER=nvidia::nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL_PLANNER_FALLBACKS=nvidia::nvidia/nemotron-3.5-lightning-30b-a3b,cohere/north-mini-code:free,z-ai/glm-5.2:free,inception::mercury-2.5
# LLM_MODEL_DEVELOPER=nvidia::nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL_DEVELOPER_FALLBACKS=nvidia::nvidia/nemotron-3.5-lightning-30b-a3b,cohere/north-mini-code:free,z-ai/glm-5.2:free,inception::mercury-2.5
# Research / Debugger / Reviewer / Security stay on the free chain only:
# LLM_MODEL_RESEARCH_FALLBACKS=cohere/north-mini-code:free,z-ai/glm-5.2:free
# LLM_MODEL_DEBUGGER_FALLBACKS=cohere/north-mini-code:free,z-ai/glm-5.2:free
# LLM_MODEL_REVIEWER_FALLBACKS=cohere/north-mini-code:free,z-ai/glm-5.2:free
# LLM_MODEL_SECURITY_FALLBACKS=cohere/north-mini-code:free,z-ai/glm-5.2:free
#
# Without a key, set FORGEMIND_MOCK_LLM=1 for a deterministic stub provider
# (tests / key-less development).
#
# MULTI-BACKEND SUPPORT: model slugs may carry a backend prefix selecting
# which OpenAI-compatible endpoint serves them. Bare slugs default to
# OpenRouter; chains may mix backends entry-by-entry (a fallback hop can
# cross providers):
#   LLM_MODEL_RESEARCH=groq::openai/gpt-oss-120b
#   LLM_MODEL_RESEARCH_FALLBACKS=nvidia::nvidia/nemotron-3-ultra-550b-a55b,cohere/north-mini-code:free
#
# Additional OpenAI-compatible backends (each needs its own API key):
# GROQ_API_KEY=        # https://api.groq.com/openai/v1 — free plan: 30 RPM / 1K RPD per model
# NVIDIA_API_KEY=your_nvidia_key_here        # https://integrate.api.nvidia.com/v1 — verify current limits at build.nvidia.com
# INCEPTION_API_KEY=your_inception_key_here  # https://api.inceptionlabs.ai/v1 — Mercury 2.5 (paid) — final fallback tier
#
# repository.list_files output cap (entries). Oversized trees are ordered
# shallow-first and truncated with an explicit notice in the result — without
# this, a real monorepo listing (~3 MB of paths) blows every model's context.
# LIST_FILES_MAX_ENTRIES=1000

# Research agent (Phase 6) — hard cap on tool calls per task before a forced
# synthesis.
# MAX_RESEARCH_TOOL_CALLS=10

# Developer agent (Phase 7) — hard cap on tool calls per task. Exhausting the
# budget without a commit is a hard failure (an implementation with no commit
# is nothing).
# MAX_DEVELOPER_TOOL_CALLS=20

# Test agent (Phase 8) — the FIRST subprocess executor. The command comes from
# repositories.test_command (detected + allowlist-validated at discovery time),
# never from agent input. TEST_TIMEOUT_SECONDS bounds a hung suite; a timeout
# becomes status "error", not "failed", so the Debugger can tell them apart.
# TEST_TIMEOUT_SECONDS=300

# Debugger agent (Phase 8) — hard cap on read-only investigation tool calls
# before a forced classification. LLM_MODEL_DEBUGGER selects its model.
# MAX_DEBUGGER_TOOL_CALLS=10
# LLM_MODEL_DEBUGGER=anthropic/claude-3.5-sonnet

# Reviewer + Security agents (Phase 9) — read-only investigation caps, and
# per-role model selection. Both draw on the SAME replan budget as the
# debugger (one MAX_REPLANS governs all replans, Section 42).
# MAX_REVIEWER_TOOL_CALLS=10
# MAX_SECURITY_TOOL_CALLS=10
# LLM_MODEL_REVIEWER=anthropic/claude-3.5-sonnet
# LLM_MODEL_SECURITY=anthropic/claude-3.5-sonnet

# GitHub agent (Phase 10) — the PR runtime. FORGEMIND_MOCK_GITHUB=1 swaps in
# a deterministic in-memory client (tests / key-less dev). With a real
# GITHUB_TOKEN the worker creates a REAL draft PR on your fork. The token is
# a secret (never logged, never persisted to git config).
# FORGEMIND_MOCK_GITHUB=1
# GITHUB_TOKEN=
# GITHUB_BASE_URL=https://api.github.com
# GITHUB_API_TIMEOUT_SECONDS=20
# GITHUB_MAX_RETRIES=3

# API auth (Phase 10.5) — a SINGLE shared-secret bearer token gating every
# state-mutating route (POST /tasks, cancel, approve, reject). Send it as
# `Authorization: Bearer <token>`. Unset in development/test it falls back to
# `forgemind-dev-token`; unset in PRODUCTION the API refuses to start. This is
# deliberately NOT multi-user auth — the audit trail records actions as
# "token-holder", and per-account auth is future work.
# FORGEMIND_API_TOKEN=

# Merge gate (Phase 12) — the ONLY repos ForgeMind may squash-merge into.
# Comma-separated `owner/repo` FORK slugs (the PRs live on your forks, never
# the upstream). PRs on the allowlist pass the gate; everything else is
# refused with `repo not in MERGE_ALLOWED_REPOS`. EMPTY/UNSET = merge is
# disabled EVERYWHERE (fail closed) — `POST /tasks/{id}/merge` will always
# answer `merged: false`.
# MERGE_ALLOWED_REPOS=sushit-prog/posthog

# Tasks reach AWAITING_APPROVAL after PR creation; POST /tasks/{id}/approve
# (or /reject) is the human checkpoint — bearer-token gated.

# Secrets for later phases (agents, tools, GitHub) — add when needed, never hardcode:
# OPENROUTER_API_KEY=
