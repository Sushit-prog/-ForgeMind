# Copy to `.env` and adjust. NEVER commit a real .env file.

# Application
APP_NAME=forgemind
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — local dev (matches docker-compose.yml; host port 5433 to avoid
# clashing with a system Postgres on 5432); prod points at Supabase:
# postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://forgemind:forgemind@localhost:5433/forgemind

# Secrets for later phases (agents, tools, GitHub) — add when needed, never hardcode:
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
